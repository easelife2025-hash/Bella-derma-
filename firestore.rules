rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isValidString(text, min, max) {
      return text is string && text.size() >= min && text.size() <= max;
    }

    // Appointments (Write-only for public, Full access for Admin)
    match /appointments/{id} {
      allow read, update, delete: if isAuthenticated();
      allow create: if true 
        && request.resource.data.keys().hasAll(['name', 'phone', 'preferredDate', 'preferredTime', 'treatment', 'status', 'createdAt'])
        && isValidString(request.resource.data.name, 1, 100)
        && isValidString(request.resource.data.phone, 5, 20)
        && request.resource.data.status == 'pending';
    }
    
    // Contact Enquiries (Write-only for public, Full access for Admin)
    match /contactEnquiries/{id} {
      allow read, update, delete: if isAuthenticated();
      allow create: if true
        && request.resource.data.keys().hasAll(['name', 'email', 'phone', 'message', 'status', 'createdAt'])
        && isValidString(request.resource.data.name, 1, 100)
        && isValidString(request.resource.data.email, 5, 150)
        && request.resource.data.status == 'new';
    }

    // Treatment Enquiries (Write-only for public, Full access for Admin)
    match /treatmentEnquiries/{id} {
      allow read, update, delete: if isAuthenticated();
      allow create: if true
        && request.resource.data.keys().hasAll(['name', 'phone', 'treatmentId', 'message', 'status', 'createdAt'])
        && isValidString(request.resource.data.name, 1, 100)
        && request.resource.data.status == 'new';
    }
  }
}
